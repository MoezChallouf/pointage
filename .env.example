# Port d'écoute du serveur Node.js / Express en local (par défaut 3000)
PORT=3000

# Fuseau horaire par défaut de l'entreprise
APP_TIMEZONE="Africa/Tunis"

# URL de l'application
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Supabase / PostgreSQL (OBLIGATOIRE)
# Supabase Dashboard > Project Settings > Database > Connection string
# > "Connection pooling" > mode "Transaction" (port 6543).
# Remplacez [YOUR-PASSWORD] par le mot de passe de la base.
# ---------------------------------------------------------------------------
SUPABASE_DB_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Secret utilisé pour signer les sessions administrateur (JWT HS256).
# Générez une valeur aléatoire longue et gardez-la secrète.
JWT_SECRET="change-me-with-a-long-random-secret"

# Paramètres Supabase (informatif - utilisés uniquement si vous branchez
# directement le client Supabase côté serveur).
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
